# ===========================
# Omnivara One - Environment Variables
# Copy to .env and fill in values
# ===========================

# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://omnivara:omnivara@localhost:5432/omnivara_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=omnivara_dev
DATABASE_USER=omnivara
DATABASE_PASSWORD=omnivara

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=omnivara-api
KAFKA_GROUP_ID=omnivara-consumers

# Auth / JWT
JWT_SECRET=change-me-in-production-use-256-bit-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AI
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Object Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=omnivara-dev
S3_REGION=us-east-1

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@omnivara.dev

# Feature Flags
ENABLE_AI_COPILOT=true
ENABLE_ADVANCED_ANALYTICS=false
