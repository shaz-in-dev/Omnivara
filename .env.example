# =============================================================================
# Omnivara One — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before running any service.
#
# REQUIRED vars (marked ★) must be set or the API will refuse to start.
# REQUIRED IN PRODUCTION (marked ★★) must be set when NODE_ENV=production.
# Optional vars have sensible defaults for local development.
#
# Generate a secure JWT_SECRET:  openssl rand -hex 32
# =============================================================================

# ── Runtime ─────────────────────────────────────────────────────────────────

# ★  NODE_ENV — 'development' | 'test' | 'production'
NODE_ENV=development

# App public URLs (used in emails and SSO callbacks)
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_AI_URL=http://localhost:8000

# ── Database ─────────────────────────────────────────────────────────────────

# ★  Full connection string — Prisma uses this directly.
#    The API appends ?connection_limit=20 in production automatically.
DATABASE_URL=postgresql://omnivara:omnivara@localhost:5432/omnivara_dev

# Individual vars (used by some scripts/tooling — keep in sync with DATABASE_URL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=omnivara_dev
DATABASE_USER=omnivara
DATABASE_PASSWORD=omnivara

# ── Cache / Session Store (Redis) ────────────────────────────────────────────

# Optional in dev (falls back to in-memory cache).
# Required for: AI usage tracking, rate limiting, session invalidation.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Event Streaming (Kafka) ──────────────────────────────────────────────────

# Only needed for Temporal workflow workers and future event-driven modules.
# Leave as localhost:9092 if using the docker-compose setup.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=omnivara-api
KAFKA_GROUP_ID=omnivara-consumers

# ── Auth / JWT ────────────────────────────────────────────────────────────────

# ★  JWT_SECRET — MUST be changed in production.
#    Minimum 32 characters. Generate: openssl rand -hex 32
#    The API will refuse to start in production with the default value.
JWT_SECRET=change-me-in-production-use-256-bit-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── SAML SSO (Enterprise) ────────────────────────────────────────────────────

# Set when configuring SAML/OIDC for enterprise customers.
# The SP metadata endpoint is: GET /api/v1/auth/sso/saml/metadata
SAML_ENTRY_POINT=
SAML_ISSUER=omnivara
SAML_CERT=

# ── AI (Anthropic + OpenAI) ──────────────────────────────────────────────────

# ★★ ANTHROPIC_API_KEY — Required for AI Copilot and daily briefs.
#    Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional — only needed if OpenAI embeddings are used instead of mock embeddings.
# In dev/test, the embedding service falls back to deterministic mock vectors.
OPENAI_API_KEY=your-openai-api-key

# ── Logging ───────────────────────────────────────────────────────────────────

# Log level: error | warn | log | debug | verbose
LOG_LEVEL=log

# ── Object Storage (S3-compatible — MinIO in dev, AWS S3 in prod) ────────────

# MinIO runs on port 9000 via docker-compose (UI at http://localhost:9001).
# In production: replace endpoint with your S3 endpoint and use IAM credentials.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=omnivara-dev
S3_REGION=us-east-1

# Email (MailHog in dev — http://localhost:8025 for inbox UI)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM_NAME=Omnivara
EMAIL_FROM_ADDRESS=no-reply@omnivara.dev

# ── Sprint 22: Production Email (Resend) ─────────────────────────────────────
# Resend is the recommended production email provider (resend.com)
# When RESEND_API_KEY is set, Resend is used instead of SMTP
# Get key from: https://resend.com/api-keys
# Note: you must verify your sending domain in Resend first
# Update EMAIL_FROM_ADDRESS to match your verified domain (e.g. no-reply@yourdomain.com)
RESEND_API_KEY=

# ── Feature Flags ────────────────────────────────────────────────────────────

ENABLE_AI_COPILOT=true
ENABLE_ADVANCED_ANALYTICS=false

# ── Port overrides ────────────────────────────────────────────────────────────

PORT=4000
AI_PORT=8000

# ── Sprint 21: Stripe Billing ────────────────────────────────────────────────

# Stripe (payments — https://stripe.com)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# Webhook secret from: stripe listen --forward-to localhost:3001/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs — create these in your Stripe dashboard
# Products → Add product → add monthly price for each plan
STRIPE_PRICE_ID_STARTER=price_starter_monthly
STRIPE_PRICE_ID_GROWTH=price_growth_monthly
STRIPE_PRICE_ID_BUSINESS=price_business_monthly

# Public key for frontend Stripe.js
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# ── Observability ─────────────────────────────────────────────────────────────

# Sentry — error tracking (https://sentry.io — free tier available)
# Create a project at sentry.io and paste the DSN here.
# When set, all API errors and Next.js client errors are reported automatically.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_DSN=

# PostHog — product analytics (https://posthog.com — free up to 1M events/month)
# Get your key at: https://us.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Intercom — support chat (https://intercom.com — free up to 1,000 contacts)
# Get App ID from: https://app.intercom.com/a/apps/<your-app>/settings/general
NEXT_PUBLIC_INTERCOM_APP_ID=

# ── Sub-processors (for DPA / security questionnaire answers) ─────────────────
#
# Omnivara uses the following sub-processors in production:
#   - AWS (database, object storage)
#   - Stripe (payment processing)
#   - Anthropic (AI inference)
#   - OpenAI (embeddings — optional)
#   - Resend (transactional email)
#   - Sentry (error tracking — optional)
#   - PostHog (analytics — optional)
#
# See /legal/dpa for the full Data Processing Agreement.
# =============================================================================
